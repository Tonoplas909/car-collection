{
  "name": "marque",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n api,web -c red,gray \"npm --prefix backend run dev\" \"npm --prefix frontend start\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "test": "vitest run && npm --prefix backend test",
    "test:rules": "vitest run",
    "test:api": "npm --prefix backend test",
    "test:web": "npm --prefix frontend test -- --watch=false",
    "seed:reset": "npm --prefix backend run seed:reset",
    "cars:enrich": "node scripts/enrich-cars.mjs",
    "cars:add": "node scripts/add-cars.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vitest": "^4.0.8"
  }
}
