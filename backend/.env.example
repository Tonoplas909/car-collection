# Copy to .env (optional). Without MONGODB_URI the API starts an embedded MongoDB
# (mongodb-memory-server) whose data is kept in backend/data/db.
# MONGODB_URI=mongodb://127.0.0.1:27017/marque
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/marque
JWT_SECRET=replace-with-a-long-random-local-secret
PORT=3000
